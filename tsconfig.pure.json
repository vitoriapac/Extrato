{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/core/**/*",
    "src/state/**/*",
    "src/storage/**/*",
    "src/repositories/**/*",
    "src/domain/**/*",
    "src/application/**/*",
    "src/ui/*.ts",
    "src/ui/*.tsx",
    "src/ui/tabs/**/*",
    "src/ui/view-models/**/*",
    "src/ui/components/**/*",
    "src/ui/subjects/**/*",
    "src/ui/calendar/**/*",
    "src/ui/help/**/*",
    "src/ui/controllers/**/*",
    "src/ui/renderers/achievement-renderer.ts",
    "src/ui/renderers/global-search-renderer.ts"
  ]
}
