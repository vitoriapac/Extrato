{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/core/**/*",
    "src/state/**/*",
    "src/storage/**/*",
    "src/repositories/**/*",
    "src/domain/**/*",
    "src/application/**/*",
    "src/ui/**/*",
    "src/reports/**/*",
    "src/features/**/*",
    "src/demo/**/*"
  ]
}
