{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/core/**/*",
    "src/state/**/*",
    "src/domain/reviews.*",
    "src/domain/topic-bookmark.*",
    "src/domain/questions/**/*",
    "src/domain/analytics/priority-score.*",
    "src/domain/planning/adaptive-planning.*",
    "src/storage/storage-provider.*",
    "src/storage/remote-sync-provider.*",
    "src/ui/controllers/remote-sync-controller.*",
    "src/ui/controllers/pip-timer-controller.*",
    "src/application/questions/question-import-service.*",
    "src/features/question-import/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/app.bundle.js",
    "src/exam-catalog.bundle.js"
  ]
}
